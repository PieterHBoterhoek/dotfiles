{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/pieter/Pictures/ascii-art.txt",
        "color": {"1": "white"},
        "height": 10,
        "width": 25,
        "padding": {
            "top": 3,
            "left": 3
        }
    },
    "display": {
        "separator":" | "
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": ".________._____________________________________."
        },
        {
            "type": "custom",
            "format": "\u001b[3m\u001b[90mHARDWARE\u001b[0m |"
        },
        {
            "type": "host",
            "key": "›  PC   ",
            "format": "{vendor} {family} ({name})",
            "keyColor": "magenta"
        },
        {
            "type": "cpu",
            "key": "›  CPU  ",
            "format": "{name} ({#4;90}{cores-physical}C/{cores-logical}T{#})",
            "keyColor": "magenta"
        },
        {
            "type": "gpu",
            "key": "›  GPU  ",
            "format": "{name}",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "›  RAM  ",
            "format": "{used} / {total}",
            "keyColor": "magenta"
        },
        {
            "type": "Display",
            "key": "›  DISP ",
            "format": "{width}x{height} @{refresh-rate}hz",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[3m\u001b[90mSOFTWARE\u001b[0m |"
        },
        {
            "type": "os",
            "key": "›  OS   ",
            "format": "{pretty-name}",
            "keyColor": "white"
        },
        {
            "type": "kernel",
            "key": "›  KERN ",
            "format": "{sysname} {release}",
            "keyColor": "white"
        },
        {
            "type": "bios",
            "key": "›  BIOS ",
            "format": "{version}",
            "keyColor": "white"
        },
        {
            "type": "lm",
            "key": "›  LM   ",
            "format": "{pretty-name} {version}",
            "keyColor": "white"
        },
        {
            "type": "wm",
            "key": "›  WM   ",
            "format": "{pretty-name} {version}",
            "keyColor": "white"
        },
        {
            "type": "terminal",
            "key": "›  TML  ",
            "format": "{pretty-name} {version}",
            "keyColor": "white"
        },
        {
            "type": "custom",
            "format": "\u001b[3m\u001b[90mMISC    \u001b[0m |"
        },
        {
            "type": "uptime",
            "key": "›  UT   ",
            "format": "{hours} hour/s & {minutes} minutes",
            "keyColor": "red"
        },
        {
            "type": "datetime",
            "key": "›  DAY  ",
            "format": "{weekday} {day-in-month} {month-name} {year}",
            "keyColor": "red"
        },
        {
            "type": "media",
            "key": "›  MUSIC",
            "format": "{artist:-15} - {title:-17}",
            "keyColor": "red"
        }, 
        {
            "type": "custom",
            "format": ".________._____________________________________."
        },  
        {
            "type": "custom",
            "format": "\u001b[35m♥  \u001b[35mD.MON\u001b[0m | \u001b[3m\u001b[36mPlay together, win together!"
        }
    ]
}
